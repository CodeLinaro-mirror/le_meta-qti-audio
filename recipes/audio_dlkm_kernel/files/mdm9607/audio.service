[Unit]
Description= Audio DLKM kernel service
SourcePath=/etc/initscripts/start_audio_le
After=firmware.mount diag-router.service
Requires=firmware.mount

[Service]
Restart=on-failure
RemainAfterExit=yes
# This service file has no binary and it is to execute the list of commands in <script>.
# Use Script file only when there is NO binary or commands to be executed/ modules to be installed cases.
ExecStartPre=/bin/sleep 35
ExecStart=/etc/initscripts/start_audio_le start
ExecStop=/etc/initscripts/start_audio_le stop
ExecStop=/bin/sh -c ' for d in /sys/class/remoteproc/remoteproc*/; do if [ \"$(cat \"$d/name\")\" ==  \"4080000.remoteproc-mss\" ]; then echo stop > $d/state; fi; done '
ExecStop=/etc/initscripts/start_audio_le verify

[Install]
WantedBy=multi-user.target


