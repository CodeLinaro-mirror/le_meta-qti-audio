    <path name="listen-ape-handset-qmic">
        <ctl name="VA_CDC_DMA_TX_0 Channels" value="Four" />
        <ctl name="VA_AIF1_CAP Mixer DEC0" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC2" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC4" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC6" value="1" />
        <ctl name="VA DMIC MUX0" value="DMIC0" />
        <ctl name="VA_DEC0 Volume" value="96" />
        <ctl name="VA DMIC MUX2" value="DMIC2" />
        <ctl name="VA_DEC2 Volume" value="96" />
        <ctl name="VA DMIC MUX4" value="DMIC4" />
        <ctl name="VA_DEC4 Volume" value="96" />
        <ctl name="VA DMIC MUX6" value="DMIC6" />
        <ctl name="VA_DEC6 Volume" value="96" />
    </path>

    <path name="listen-ape-handset-6mic">
        <ctl name="VA_CDC_DMA_TX_0 Channels" value="Six" />
        <ctl name="VA_AIF1_CAP Mixer DEC2" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC3" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC4" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC6" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC7" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC0" value="1" />
        <ctl name="VA DMIC MUX2" value="DMIC2" />
        <ctl name="VA DMIC MUX3" value="DMIC3" />
        <ctl name="VA DMIC MUX4" value="DMIC4" />
        <ctl name="VA DMIC MUX6" value="DMIC6" />
        <ctl name="VA DMIC MUX7" value="DMIC7" />
        <ctl name="VA DMIC MUX0" value="DMIC0" />
    </path>

    <path name="listen-ape-handset-7mic">
        <ctl name="VA_CDC_DMA_TX_0 Channels" value="Seven" />
        <ctl name="VA_AIF1_CAP Mixer DEC0" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC1" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC2" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC3" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC4" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC5" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC6" value="1" />
        <ctl name="VA DMIC MUX0" value="DMIC0" />
        <ctl name="VA DMIC MUX1" value="DMIC1" />
        <ctl name="VA DMIC MUX2" value="DMIC2" />
        <ctl name="VA DMIC MUX3" value="DMIC3" />
        <ctl name="VA DMIC MUX4" value="DMIC4" />
        <ctl name="VA DMIC MUX5" value="DMIC5" />
        <ctl name="VA DMIC MUX6" value="DMIC6" />
    </path>

    <path name="listen-ape-handset-8mic">
        <ctl name="VA_CDC_DMA_TX_0 Channels" value="Eight" />
        <ctl name="VA_AIF1_CAP Mixer DEC0" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC1" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC2" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC3" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC4" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC5" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC6" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC7" value="1" />
        <ctl name="VA DMIC MUX0" value="DMIC0" />
        <ctl name="VA DMIC MUX1" value="DMIC1" />
        <ctl name="VA DMIC MUX2" value="DMIC2" />
        <ctl name="VA DMIC MUX3" value="DMIC3" />
        <ctl name="VA DMIC MUX4" value="DMIC4" />
        <ctl name="VA DMIC MUX5" value="DMIC5" />
        <ctl name="VA DMIC MUX6" value="DMIC6" />
        <ctl name="VA DMIC MUX7" value="DMIC7" />
    </path>

    <path name="echo-reference">
        <ctl name="AUDIO_REF_EC_UL1 MUX" value="I2S_RX"/>
        <ctl name="EC Reference Channels" value="Twelve"/>
        <ctl name="EC Reference Bit Format" value="S16_LE"/>
        <ctl name="EC Reference SampleRate" value="48000"/>
        <!-- Output channel Co-efficients are required if downmix channels != ec_ref channels -->
        <ctl name="EC Reference Downmixed Channels" value="Six"/>
        <!-- EC Reference Downmix Co-efficients (16384 is Unity) -->
        <!-- Set value(without id) to default/0 explicitly, to avoid garbage initialization-->
        <!-- Co-efficients for First Output channel -->
        <ctl name="EC Reference ChMixer Weights Ch1" value="0"/>
        <ctl name="EC Reference ChMixer Weights Ch1" id="0" value="8174"/>
        <ctl name="EC Reference ChMixer Weights Ch1" id="1" value="8174"/>
        <!-- Co-efficients for Second Output channel -->
        <ctl name="EC Reference ChMixer Weights Ch2" value="0"/>
        <ctl name="EC Reference ChMixer Weights Ch2" id="2" value="8174"/>
        <ctl name="EC Reference ChMixer Weights Ch2" id="3" value="8174"/>
        <!-- Co-efficients for Third Output channel -->
        <ctl name="EC Reference ChMixer Weights Ch3" value="0"/>
        <ctl name="EC Reference ChMixer Weights Ch3" id="4" value="8174"/>
        <ctl name="EC Reference ChMixer Weights Ch3" id="5" value="8174"/>
        <!-- Co-efficients for Fourth Output channel -->
        <ctl name="EC Reference ChMixer Weights Ch4" value="0"/>
        <ctl name="EC Reference ChMixer Weights Ch4" id="6" value="8174"/>
        <ctl name="EC Reference ChMixer Weights Ch4" id="7" value="8174"/>
        <!-- Co-efficient for Fifth Output channel -->
        <ctl name="EC Reference ChMixer Weights Ch5" value="0"/>
        <ctl name="EC Reference ChMixer Weights Ch5" id="8" value="8174"/>
        <ctl name="EC Reference ChMixer Weights Ch5" id="9" value="8174"/>
        <!-- Co-efficient for Sixth Output channel -->
        <ctl name="EC Reference ChMixer Weights Ch6" value="0"/>
        <ctl name="EC Reference ChMixer Weights Ch6" id="10" value="8174"/>
        <ctl name="EC Reference ChMixer Weights Ch6" id="11" value="8174"/>
    </path>

    <path name="echo-reference line">
        <ctl name="AUDIO_REF_EC_UL1 MUX" value="SLIM_RX"/>
        <ctl name="EC Reference Channels" value="Two"/>
        <ctl name="EC Reference Bit Format" value="S16_LE"/>
        <ctl name="EC Reference SampleRate" value="48000"/>
    </path>

    <!-- TODO: add controls for ec-ref on other devices -->
</mixer>
