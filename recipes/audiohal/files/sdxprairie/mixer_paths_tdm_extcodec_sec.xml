<mixer>
    <!-- These are the initial mixer settings -->
    <ctl name="PCM Playback Volume" value="0xffffe732 0xffffe732" />
    <ctl name="PGA Capture Volume" value="0 0" />
    <ctl name="Voice Rx Device Mute" id="0" value="0" />
    <ctl name="Voice Rx Device Mute" id="1" value="-1" />
    <ctl name="Voice Rx Device Mute" id="2" value="20" />
    <ctl name="Voice Tx Mute" id="0" value="0" />
    <ctl name="Voice Tx Mute" id="1" value="-1" />
    <ctl name="Voice Tx Mute" id="2" value="500" />
    <ctl name="Voice Rx Gain" id="0" value="0" />
    <ctl name="Voice Rx Gain" id="1" value="-1" />
    <ctl name="Voice Rx Gain" id="2" value="20" />
    <ctl name="AUX_PCM_RX Audio Mixer MultiMedia1" value="0" />
    <ctl name="AUX_PCM_RX Audio Mixer MultiMedia4" value="0" />
    <ctl name="AUX_PCM_RX Audio Mixer MultiMedia5" value="0" />
    <ctl name="MultiMedia1 Mixer AUX_PCM_UL_TX" value="0" />
    <ctl name="MultiMedia8 Mixer AUX_PCM_UL_TX" value="0" />
    <ctl name="PRI_MI2S_RX Port Mixer PRI_MI2S_TX" value="0" />
    <ctl name="PRI_MI2S_RX Audio Mixer DTMF" value="0" />
    <ctl name="SEC_TDM_RX_0 Port Mixer SEC_TDM_TX_0" value="0" />
    <ctl name="SEC_TDM_RX_0 Audio Mixer DTMF" value="0" />
    <ctl name="SEC_TDM_RX_1 Port Mixer SEC_TDM_TX_1" value="0" />
    <ctl name="SEC_TDM_RX_1 Audio Mixer DTMF" value="0" />
    <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" value="0" />
    <ctl name="SEC_TDM_RX_0 Audio Mixer MultiMedia1" value="0" />
    <ctl name="SEC_TDM_RX_1 Audio Mixer MultiMedia1" value="0" />
    <ctl name="Incall_Music Audio Mixer MultiMedia2" value="0" />
    <ctl name="Incall_Music Audio Mixer MultiMedia4" value="0" />

    <!-- ctl to configure secondary TDM mode.
        slave/master
    -->
    <ctl name="SEC_TDM Mode" value="slave" />

    <!-- ctl to configure TDM slots-->
    <ctl name="SEC_TDM SlotNumber" value="Two" />
    <ctl name="SEC_TDM SlotWidth" value="16" />
    <ctl name="SEC_TDM_RX_0 Channels" value="One" />
    <ctl name="SEC_TDM_TX_0 Channels" value="One" />
    <ctl name="SEC_TDM_RX_1 Channels" value="One" />
    <ctl name="SEC_TDM_TX_1 Channels" value="One" />
    <ctl name="SEC_TDM_RX_0 SlotMapping" id="0" value="0" />
    <ctl name="SEC_TDM_RX_1 SlotMapping" id="0" value="2" />
    <ctl name="SEC_TDM_TX_0 SlotMapping" id="0" value="0" />
    <ctl name="SEC_TDM_TX_1 SlotMapping" id="0" value="2" />

    <!-- Audio ctl -->
    <ctl name="MultiMedia1 Mixer PRI_MI2S_TX" value="0" />
    <ctl name="MultiMedia1 Mixer SEC_TDM_TX_0" value="0" />
    <ctl name="MultiMedia1 Mixer SEC_TDM_TX_1" value="0" />
    <!-- Audio ctl  end-->

    <!-- Multimode Voice1 -->
    <ctl name="VoiceMMode1_Tx Mixer PRI_MI2S_TX_MMode1" value="0" />
    <ctl name="PRI_MI2S_RX_Voice Mixer VoiceMMode1" value="0" />
    <ctl name="VoiceMMode1_Tx Mixer SEC_TDM_TX_0_MMode1" value="0" />
    <ctl name="SEC_TDM_RX_0_Voice Mixer VoiceMMode1" value="0" />
    <ctl name="VoiceMMode1_Tx Mixer SEC_TDM_TX_1_MMode1" value="0" />
    <ctl name="SEC_TDM_RX_1_Voice Mixer VoiceMMode1" value="0" />
    <!-- Miltimode Voice1 end-->

    <!-- Multimode Voice2 -->
    <ctl name="VoiceMMode2_Tx Mixer SEC_TDM_TX_1_MMode2" value="0" />
    <ctl name="SEC_TDM_RX_1_Voice Mixer VoiceMMode2" value="0" />
    <!-- Multimode Voice2 end-->

    <!-- CS voice -->
      <ctl name="PRI_MI2S_RX_Voice Mixer CSVoice" value="0" />
      <ctl name="Voice_Tx Mixer PRI_MI2S_TX_Voice" value="0" />
      <ctl name="PRI_MI2S_RX_Voice Mixer DTMF" value="0" />
    <!-- CS voice end -->

    <ctl name="Incall_Music_DL Audio Mixer MultiMedia4" value="0" />
    <ctl name="Incall_Music_DL Audio Mixer MultiMedia7" value="0" />

<!-- voice and audio paths -->
   <path name="voice-call">
      <ctl name="PRI_MI2S_RX_Voice Mixer CSVoice" value="1" />
      <ctl name="Voice_Tx Mixer PRI_MI2S_TX_Voice" value="1" />
      <ctl name="PRI_MI2S_RX_Voice Mixer DTMF" value="1" />
   </path>

    <path name="voicemmode1-call speaker">
        <ctl name="PGA Capture Volume" value="80 80" />
        <ctl name="PCM Playback Volume" value="100 100" />
        <ctl name="VoiceMMode1_Tx Mixer PRI_MI2S_TX_MMode1" value="1" />
        <ctl name="PRI_MI2S_RX_Voice Mixer VoiceMMode1" value="1" />
        <ctl name="PRI_MI2S_RX_Voice Mixer DTMF" value="1" />
    </path>

    <path name="voicemmode1-call secondary_tdm_0">
        <ctl name="VoiceMMode1_Tx Mixer SEC_TDM_TX_0_MMode1" value="1" />
        <ctl name="SEC_TDM_RX_0_Voice Mixer VoiceMMode1" value="1" />
        <ctl name="SEC_TDM_RX_0_Voice Mixer DTMF" value="1" />
    </path>

    <path name="voicemmode1-call secondary_tdm_1">
        <ctl name="VoiceMMode1_Tx Mixer SEC_TDM_TX_1_MMode1" value="1" />
        <ctl name="SEC_TDM_RX_1_Voice Mixer VoiceMMode1" value="1" />
        <ctl name="SEC_TDM_RX_1_Voice Mixer DTMF" value="1" />
    </path>

    <path name="voicemmode2-call speaker">
        <ctl name="PGA Capture Volume" value="80 80" />
        <ctl name="PCM Playback Volume" value="100 100" />
        <ctl name="VoiceMMode2_Tx Mixer PRI_MI2S_TX_MMode2" value="1" />
        <ctl name="PRI_MI2S_RX_Voice Mixer VoiceMMode2" value="1" />
        <ctl name="PRI_MI2S_RX_Voice Mixer DTMF" value="1" />
    </path>

    <path name="voicemmode2-call secondary_tdm_0">
        <ctl name="VoiceMMode2_Tx Mixer SEC_TDM_TX_0_MMode2" value="1" />
        <ctl name="SEC_TDM_RX_0_Voice Mixer VoiceMMode2" value="1" />
        <ctl name="SEC_TDM_RX_0_Voice Mixer DTMF" value="1" />
    </path>

    <path name="voicemmode2-call secondary_tdm_1">
        <ctl name="VoiceMMode2_Tx Mixer SEC_TDM_TX_1_MMode2" value="1" />
        <ctl name="SEC_TDM_RX_1_Voice Mixer VoiceMMode2" value="1" />
        <ctl name="SEC_TDM_RX_1_Voice Mixer DTMF" value="1" />
    </path>

    <path name="voicemmode1-call secondary">
        <ctl name="VoiceMMode1_Tx Mixer SEC_MI2S_TX_MMode1" value="1" />
        <ctl name="SEC_MI2S_RX_Voice Mixer VoiceMMode1" value="1" />
        <ctl name="SEC_MI2S_RX_Voice Mixer DTMF" value="1" />
    </path>

    <path name="voicemmode2-call secondary">
        <ctl name="VoiceMMode2_Tx Mixer SEC_MI2S_TX_MMode2" value="1" />
        <ctl name="SEC_MI2S_RX_Voice Mixer VoiceMMode2" value="1" />
        <ctl name="SEC_MI2S_RX_Voice Mixer DTMF" value="1" />
    </path>

    <path name="voicemmode1-call bt-sco">
        <ctl name="VoiceMMode1_Tx Mixer SEC_AUX_PCM_TX_MMode1" value="1" />
        <ctl name="SEC_AUX_PCM_RX_Voice Mixer VoiceMMode1" value="1" />
    </path>

    <path name="voicemmode2-call bt-sco">
        <ctl name="VoiceMMode2_Tx Mixer SEC_AUX_PCM_TX_MMode2" value="1" />
        <ctl name="SEC_AUX_PCM_RX_Voice Mixer VoiceMMode2" value="1" />
    </path>

    <path name="audio-record speaker-mic">
        <ctl name="PGA Capture Volume" value="80 80" />
        <ctl name="MultiMedia1 Mixer PRI_MI2S_TX" value="1" />
    </path>

    <path name="audio-record secondary_tdm_0">
        <ctl name="MultiMedia1 Mixer SEC_TDM_TX_0" value="1" />
    </path>

    <path name="audio-record secondary_tdm_1">
        <ctl name="MultiMedia1 Mixer SEC_TDM_TX_1" value="1" />
    </path>

    <path name="deep-buffer-playback speaker">
        <ctl name="PCM Playback Volume" value="100 100" />
        <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" value="1" />
    </path>

    <path name="deep-buffer-playback secondary_tdm_0">
        <ctl name="SEC_TDM_RX_0 Audio Mixer MultiMedia1" value="1" />
    </path>

    <path name="deep-buffer-playback secondary_tdm_1">
        <ctl name="SEC_TDM_RX_1 Audio Mixer MultiMedia1" value="1" />
    </path>


    <path name="compress-offload-playback speaker">
        <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia4" value="1" />
    </path>

    <path name="compress-offload-playback secondary_tdm_0">
        <ctl name="SEC_TDM_RX_0 Audio Mixer MultiMedia4" value="1" />
    </path>

    <path name="compress-offload-playback secondary_tdm_1">
        <ctl name="SEC_TDM_RX_1 Audio Mixer MultiMedia4" value="1" />
    </path>

    <path name="compress-offload-playback afe-proxy">
        <ctl name="AFE_PCM_RX Audio Mixer MultiMedia4" value="1" />
    </path>

    <path name="compress-offload-playback2 speaker">
        <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia7" value="1" />
    </path>

    <path name="compress-offload-playback2 secondary_tdm_0">
        <ctl name="SEC_TDM_RX_0 Audio Mixer MultiMedia7" value="1" />
    </path>

    <path name="compress-offload-playback2 secondary_tdm_1">
        <ctl name="SEC_TDM_RX_1 Audio Mixer MultiMedia7" value="1" />
    </path>

    <path name="compress-offload-playback2 afe-proxy">
        <ctl name="AFE_PCM_RX Audio Mixer MultiMedia7" value="1" />
    </path>

    <!-- These are actual sound device specific mixer settings -->
    <path name="speaker">
    </path>

    <path name="speaker-mic">
    </path>

    <path name="handset">
    </path>

    <path name="handset-mic">
    </path>

    <path name="headphones">
    </path>

    <path name="voice-handset">
    </path>

    <path name="headset-mic">
    </path>

    <path name="voice-speaker">
    </path>

    <path name="voice-speaker-mic">
    </path>

    <path name="voice-headphones">
    </path>

    <path name="voice-headset-mic">
        <path name="headset-mic" />
    </path>

    <path name="voice-rec-mic">
    </path>

    <path name="wsa-speaker">
        <path name="speaker" />
    </path>

    <path name="wsa-voice-speaker">
        <path name="speaker" />
    </path>

    <path name="bt-sco-mic">
    </path>

    <path name="bt-sco-headset">
    </path>

    <path name="audio-afe-loopback speaker">
        <ctl name="PRI_MI2S_RX Port Mixer PRI_MI2S_TX" value="1" />
    </path>

    <path name="audio-afe-loopback secondary_tdm_0">
        <ctl name="SEC_TDM_RX_0 Port Mixer SEC_TDM_TX_0" value="1" />
    </path>

    <path name="audio-afe-loopback secondary_tdm_1">
        <ctl name="SEC_TDM_RX_1 Port Mixer SEC_TDM_TX_1" value="1" />
    </path>

    <path name="audio-dtmf-playback">
        <ctl name="PRI_MI2S_RX Audio Mixer DTMF" value="1" />
    </path>

    <path name="incall_music_uplink">
        <ctl name="Incall_Music Audio Mixer MultiMedia2" value="1" />
    </path>

    <path name="incall_music_uplink voice-tx">
        <path name="incall_music_uplink" />
    </path>

    <path name="compress-offload-playback voice-tx">
        <ctl name="Incall_Music Audio Mixer MultiMedia4" value="1" />
    </path>

    <path name="compress-offload-playback2 voice-tx">
        <ctl name="Incall_Music Audio Mixer MultiMedia7" value="1" />
    </path>

    <path name="incall-rec-downlink">
        <ctl name="MultiMedia1 Mixer VOC_REC_DL" value="1" />
    </path>

    <path name="incall-rec-downlink incall-rec-rx">
        <path name="incall-rec-downlink" />
    </path>

    <path name="compress-offload-playback voice-dl-tx">
        <ctl name="Incall_Music_DL Audio Mixer MultiMedia4" value="1" />
    </path>

    <path name="compress-offload-playback2 voice-dl-tx">
        <ctl name="Incall_Music_DL Audio Mixer MultiMedia7" value="1" />
    </path>

    <path name="afe-proxy-record afe-proxy">
    </path>

</mixer>
