 include/Makefile.am                    |   7 +-
 include/tinycompress/compress_plugin.h |  89 ++++++
 src/lib/Makefile.am                    |   4 +-
 src/lib/compress.c                     | 120 ++++---
 src/lib/compress_hw.c                  | 140 +++++++++
 src/lib/compress_ops.h                 |  50 +++
 src/lib/compress_plugin.c              | 418 +++++++++++++++++++++++++
 src/lib/snd_utils.c                    | 149 +++++++++
 src/lib/snd_utils.h                    |  72 +++++
 10 files changed, 1011 insertions(+), 56 deletions(-)
 create mode 100644 include/tinycompress/compress_plugin.h
 create mode 100644 src/lib/compress_hw.c
 create mode 100644 src/lib/compress_ops.h
 create mode 100644 src/lib/compress_plugin.c
 create mode 100644 src/lib/snd_utils.c
 create mode 100644 src/lib/snd_utils.h

diff --git a/configure.ac b/configure.ac
index 416d93b..c9ad820 100644
--- a/configure.ac
+++ b/configure.ac
@@ -23,6 +23,24 @@ AM_PROG_CC_C_O

 # Checks for library functions.

+AC_ARG_WITH([glib],
+AC_HELP_STRING([--with-glib],
+         [enable glib, Build against glib. Use this when building for HLOS systems which use glib]))
+
+if (test "x${with_glib}" = "xyes"); then
+        PKG_CHECK_MODULES(GTHREAD, gthread-2.0 >= 2.16, dummy=yes,
+                                AC_MSG_ERROR(GThread >= 2.16 is required))
+        PKG_CHECK_MODULES(GLIB, glib-2.0 >= 2.16, dummy=yes,
+                                AC_MSG_ERROR(GLib >= 2.16 is required))
+        GLIB_CFLAGS="$GLIB_CFLAGS $GTHREAD_CFLAGS"
+        GLIB_LIBS="$GLIB_LIBS $GTHREAD_LIBS"
+
+        AC_SUBST(GLIB_CFLAGS)
+        AC_SUBST(GLIB_LIBS)
+fi
+
+AM_CONDITIONAL(USE_GLIB, test "x${with_glib}" = "xyes")
+
 AC_CONFIG_FILES([
 Makefile
 include/Makefile
