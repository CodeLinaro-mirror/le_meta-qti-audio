    </path>

    <path name="audio-capture">
        <ctl name="MultiMedia2 Mixer VA_CDC_DMA_TX_0" value="1" />
    </path>

    <path name="listen-ape-handset-mic">
        <ctl name="VA_AIF1_CAP Mixer DEC0" value="1" />
        <ctl name="VA DMIC MUX0" value="DMIC0" />
    </path>

    <path name="listen-ape-handset-mic-preproc">
        <path name="listen-ape-handset-mic" />
    </path>

    <path name="listen-ape-handset-dmic">
        <ctl name="VA_CDC_DMA_TX_0 Channels" value="Two" />
        <ctl name="VA_AIF1_CAP Mixer DEC3" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC7" value="1" />
        <ctl name="VA DMIC MUX3" value="DMIC3" />
        <ctl name="VA DMIC MUX7" value="DMIC7" />
    </path>

    <path name="listen-ape-handset-tmic">
        <ctl name="VA_CDC_DMA_TX_0 Channels" value="Three" />
        <ctl name="VA_AIF1_CAP Mixer DEC2" value="1" />
        <ctl name="VA_AIF1_CAP Mixer DEC4" value="1" />
