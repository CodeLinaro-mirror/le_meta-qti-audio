[Unit]
Description=Audio Init Service
After=firmware-mount.service init_sys_mss.service
Requires=firmware-mount.service init_sys_mss.service
StartLimitBurst=10

[Service]
Type=forking
Restart=on-failure
RemainAfterExit=yes
ExecStart=/etc/initscripts/start_audio_le start
ExecStop=/etc/initscripts/start_audio_le stop

[Install]
WantedBy=sysinit.target
