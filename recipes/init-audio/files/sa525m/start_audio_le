export MODULE_BASE=/lib/modules/`uname -r`/
set -e

case "$1" in
  start)
        echo -n "Starting/Loading audio module: "

        echo "audio:start/load" > /dev/kmsg
        modprobe snd_event_dlkm.ko
        modprobe pinctrl_wcd_dlkm.ko
        modprobe q6_dlkm.ko
        modprobe q6_pdr_dlkm.ko
        modprobe q6_notifier_dlkm.ko
        modprobe gpr_dlkm.ko
        modprobe spf_core_dlkm.ko
        modprobe audio_prm_dlkm.ko
        modprobe audpkt_ion_dlkm.ko
        modprobe audio_pkt_dlkm.ko
        modprobe adsp_loader_dlkm.ko
        modprobe mvm.ko
        modprobe stub_dlkm.ko
        echo 1 > /sys/kernel/boot_adsp/boot
        modprobe stub_dlkm.ko
        modprobe platform_dlkm.ko
        modprobe machine_dlkm.ko


        echo "done loading audio_kernel module"
        ;;
  stop)
        echo -n "Bypassing Unloading of  audio_kernel modules "
	echo 0 > /sys/kernel/boot_adsp/boot
        ;;
  restart)
        $0 stop
        $0 start
        ;;
  *)
        echo "Usage { start | stop | restart}" >&2
        exit 1
        ;;
esac

exit 0
